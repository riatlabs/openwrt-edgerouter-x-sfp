# OpenWrt production config seed for the Ubiquiti EdgeRouter X SFP
#
# This is a diffconfig seed. build.sh copies it to <tree>/.config and runs
# `make defconfig`; symbols not listed here use the target defaults.
#
# Package basis: openwrt-rb5009, adapted for the MT7621 EdgeRouter X SFP.
# RB5009-only mtpoe-ctrl and kmod-spi-dev are intentionally absent: this board
# has Ubiquiti GPIO-controlled PoE outputs and an SFP cage, not the MikroTik PoE
# MCU and SPI layout used by mtpoe-ctrl.

# --- Target -----------------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_ubnt_edgerouter-x-sfp=y

# --- Mesh routing -----------------------------------------------------------
CONFIG_PACKAGE_olsrd=y
CONFIG_PACKAGE_olsrd-mod-jsoninfo=y
CONFIG_PACKAGE_olsrd-mod-txtinfo=y
CONFIG_PACKAGE_oonf-olsrd2=y
CONFIG_PACKAGE_oonf-init-scripts=y

# --- WireGuard VPN ----------------------------------------------------------
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-autoip=y

# --- Management -------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# --- EdgeRouter X SFP hardware ---------------------------------------------
# The target profile also carries these through DEVICE_PACKAGES; keeping them
# explicit makes the hardware contract visible and catches dependency drift.
CONFIG_PACKAGE_kmod-sfp=y
CONFIG_PACKAGE_kmod-i2c-algo-pca=y
CONFIG_PACKAGE_kmod-gpio-pca953x=y

# --- Convenience ------------------------------------------------------------
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_conntrack=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# --- PPP / VLAN test support ------------------------------------------------
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

# --- Network test support ----------------------------------------------------
# Physical throughput tests use external Linux traffic nodes; no veth module is
# packaged into the router image.
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_netcat=y
CONFIG_PACKAGE_socat=y

# --- Build hygiene ----------------------------------------------------------
CONFIG_MAKE_TOOLCHAIN=y
