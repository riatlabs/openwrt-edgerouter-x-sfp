def key_type(line: str) -> str | None:
    """authorized_keys format: [options] type base64 [comment]. Options are one
    field (spaces only inside double quotes); the comment is free text
    (apostrophes and all), so it is not parsed."""
    rest = line.strip()
    if not re.match(r"(ssh|ecdsa|sk)-", rest):   # skip the options field
        quoted, i = False, 0
        while i < len(rest) and (quoted or not rest[i].isspace()):
            if rest[i] == "\\":
                i += 1
            elif rest[i] == '"':
                quoted = not quoted
            i += 1
        if quoted:
            return None
        rest = rest[i:].lstrip()
    match = re.match(r"((?:ssh|ecdsa|sk)-[a-z0-9@.-]+)\s+AAAA", rest)
    return match.group(1) if match else None


def uci_sections(text: str) -> list[tuple[str, str, dict[str, list[str]]]]:
    """(type, name, {option: [values]}) for each 'config' section of a UCI file."""
    sections: list[tuple[str, str, dict[str, list[str]]]] = []
    for line in text.splitlines():
        try:
            words = shlex.split(line, comments=True)
        except ValueError:
            continue
        if len(words) >= 2 and words[0] == "config":
            sections.append((words[1], words[2] if len(words) > 2 else "", {}))
        elif len(words) >= 3 and words[0] in ("option", "list") and sections:
            sections[-1][2].setdefault(words[1], []).append(words[2])
    return sections


def networks_on_eth0(sections) -> set[str]:
    """Interfaces that carry untagged eth0 traffic: eth0 itself, a bridge with
    eth0 as a port, or a bridge VLAN with eth0 untagged ('eth0:u', 'eth0:u*').
    Tagged VLANs (eth0.100, 'eth0:t') do not count: the operator's link-local
    traffic arrives untagged."""
    def values(options, key):
        return [word for value in options.get(key, []) for word in value.split()]

    devices = {"eth0"}
    for kind, _, options in sections:
        if kind == "device" and "eth0" in values(options, "ports"):
            devices.update(values(options, "name"))
    for kind, _, options in sections:
        if kind == "bridge-vlan" and {"eth0:u", "eth0:u*"} & set(values(options, "ports")):
            devices.update(f"{d}.{v}" for d in values(options, "device") for v in values(options, "vlan"))
    return {name for kind, name, options in sections if kind == "interface"
            and devices & set(values(options, "device") + values(options, "ifname"))}


def poe_ports(value: str) -> tuple[str, ...]:
    ports = value.split(",")
    if any(port not in {f"eth{i}" for i in range(5)} for port in ports):
        raise argparse.ArgumentTypeError("PoE ports must be eth0 through eth4, comma-separated")
    return tuple(dict.fromkeys(ports))


def build_access_config(authorized_keys: Path, extra: Path | None, output: Path,
                        ports: tuple[str, ...] = ()) -> None:
    if any(port not in {f"eth{i}" for i in range(5)} for port in ports):
        sys.exit("PoE ports must be eth0 through eth4")
    text = authorized_keys.read_text(encoding="utf-8", errors="replace")
    if "PRIVATE KEY" in text:
        sys.exit(f"{authorized_keys} contains a private key; give public keys only")
    keys = [line.strip() for line in text.splitlines() if line.strip() and not line.strip().startswith("#")]
    types = [key_type(key) for key in keys]
    if None in types:
        sys.exit(f"{authorized_keys}: not an authorized_keys line: {keys[types.index(None)][:60]}")
    # OpenWrt's Dropbear is built without ECC and security-key support: an
    # ECDSA or sk- key would be accepted here and then fail to log in.
    unusable = [t for t in types if t not in ("ssh-ed25519", "ssh-rsa")]
    if unusable:
        sys.exit(f"{authorized_keys}: OpenWrt's Dropbear accepts only ssh-ed25519 and ssh-rsa keys, "
                 f"found {', '.join(unusable)}")
    if not keys:
        sys.exit(f"{authorized_keys} has no SSH public keys")

    def add(tar: tarfile.TarFile, name: str, data: bytes, mode: int) -> None:
        info = tarfile.TarInfo(name)
        info.size, info.mode = len(data), mode
        tar.addfile(info, io.BytesIO(data))

    if extra and not extra.is_dir():
        sys.exit(f"--files {extra} is not a directory")
    links = [p for p in extra.rglob("*") if p.is_symlink()] if extra else []
    if links:  # a file link would be copied as a file, a directory link skipped
        sys.exit(f"--files contains symbolic links ({', '.join(map(str, links[:3]))}); copy the real files in")
    if not output.parent.is_dir():
        sys.exit(f"-o {output}: directory {output.parent} does not exist")
    for generated in ("etc/dropbear/authorized_keys", "etc/uci-defaults/99-erx-remote-access",
                      "etc/uci-defaults/98-erx-poe", "usr/lib/erx-migrate/poe-setup.sh",
                      "etc/init.d/gpio_switch"):
        if extra and (extra / generated).exists():
            sys.exit(f"--files {extra} contains {generated}, which access-config generates; "
                     "pass keys with --authorized-keys instead")
    # The access rule has src='wan': eth0 must end up in the firewall zone 'wan'.
    # Files that are not supplied keep the image defaults (eth0 is 'wan'/'wan6').
    network = extra / "etc/config/network" if extra else None
    firewall = extra / "etc/config/firewall" if extra else None
    eth0_networks = ({"wan", "wan6"} if not (network and network.is_file())
                     else networks_on_eth0(uci_sections(network.read_text(encoding="utf-8", errors="replace"))))
    wan_networks, wan_devices = {"wan", "wan6"}, set()
    if firewall and firewall.is_file():
        zones = [o for t, _, o in uci_sections(firewall.read_text(encoding="utf-8", errors="replace"))
                 if t == "zone" and o.get("name") == ["wan"]]
        if not zones:
            sys.exit(f"{firewall} has no zone with option name 'wan' (firewall4 takes the zone name "
                     "from that option, not from the section name): the access rule for eth0 "
                     "(src='wan') would not match and the router would be unreachable")
        wan_networks = {n for o in zones for value in o.get("network", []) for n in value.split()}
        wan_devices = {d for o in zones for value in o.get("device", []) for d in value.split()}
    if not (eth0_networks & wan_networks or "eth0" in wan_devices):   # a zone may take the device directly
        sys.exit(f"eth0 is not in the firewall zone 'wan' (eth0 carries {sorted(eth0_networks) or 'no interface'}, "
                 f"zone 'wan' covers {sorted(wan_networks)}): the access rule would not match and the "
                 "router would be unreachable")
    with tarfile.open(output, "w:gz") as tar:
        if extra:  # per-device files (network, olsrd, ...) laid out as on the router
            for path in sorted(extra.rglob("*")):
                # macOS metadata: .DS_Store and AppleDouble "._name" files
                if path.is_file() and path.name != ".DS_Store" and not path.name.startswith("._"):
                    mode = path.stat().st_mode  # no group/other write, whatever the host filesystem says
                    add(tar, path.relative_to(extra).as_posix(), path.read_bytes(),
                        mode & (0o755 if mode & 0o111 else 0o644))
        if ports:
            add(tar, "etc/init.d/gpio_switch",
                (HERE / "build/gpio-switch.sh").read_bytes(), 0o755)
            add(tar, "usr/lib/erx-migrate/poe-setup.sh",
                (HERE / "build/poe-setup.sh").read_bytes(), 0o755)
            script = "#!/bin/sh\nsh /usr/lib/erx-migrate/poe-setup.sh " + " ".join(ports) + "\n"
            add(tar, "etc/uci-defaults/98-erx-poe", script.encode(), 0o755)
        add(tar, "etc/dropbear/authorized_keys", ("\n".join(keys) + "\n").encode(), 0o600)
        add(tar, "etc/uci-defaults/99-erx-remote-access", ACCESS_DEFAULTS.encode(), 0o755)
    if output.stat().st_size > CONFIG_LIMIT:
        output.unlink()
        sys.exit(f"access.tgz would be larger than {CONFIG_LIMIT // MIB} MiB (flash refuses it); keep large files out")
    print(f"wrote {output} ({len(keys)} SSH keys{', plus ' + str(extra) if extra else ''})")


def cmd_access_config(args) -> None:
    build_access_config(Path(args.authorized_keys), Path(args.files) if args.files else None,
                        Path(args.output), args.poe_ports)


# --------------------------------------------------------------------- main

def existing_file(value: str) -> Path:
    path = Path(value)
    if not path.is_file():
        raise argparse.ArgumentTypeError(f"no such file: {value}")
    return path


def main(argv=None) -> None:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("check", help="read-only EdgeOS check")
    p.add_argument("router")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("bridge", help="install the 19.07 RAM bridge through EdgeOS and reboot")
    p.add_argument("router")
    p.add_argument("bridge_tar", type=existing_file)
    p.set_defaults(func=cmd_bridge)

    p = sub.add_parser("flash", help="from the bridge: write OpenWrt and reboot")
    p.add_argument("router")
    p.add_argument("sysupgrade", type=existing_file)
    p.add_argument("--config", type=existing_file, help="access.tgz from 'access-config', restored on first boot")
    p.set_defaults(func=cmd_flash)

    p = sub.add_parser("verify", help="read-only check of the migrated OpenWrt")
    p.add_argument("router")
    p.add_argument("sysupgrade", nargs="?", type=existing_file, help="optional image to test with sysupgrade -T")
    p.set_defaults(func=cmd_verify)

    p = sub.add_parser("access-config", help="build the first-boot config that keeps the router reachable")
    p.add_argument("--authorized-keys", required=True, type=existing_file)
    p.add_argument("--files", help="optional directory of extra files, e.g. etc/config/network")
    p.add_argument("--poe-ports", type=poe_ports, default=(),
                   help="experimental: enable passive PoE on these ports, e.g. eth1,eth4")
    p.add_argument("-o", "--output", required=True)
    p.set_defaults(func=cmd_access_config)

    args = parser.parse_args(argv)
    if not FLASH_SCRIPT.is_file():
        parser.error(f"{FLASH_SCRIPT} is missing: run erx-migrate from a complete release2 directory")
    router = getattr(args, "router", "")
    if args.command in ("flash", "verify") and not router.startswith("root@"):
        parser.error(f"{args.command} logs in as root: use root@ADDRESS")
    if args.command in ("check", "bridge") and "@" not in router:
        parser.error(f"{args.command} needs the EdgeOS user, e.g. ubnt@ADDRESS")
    host = router.split("@")[-1]
    if host.startswith("["):
        parser.error(f"{host}: give the bare address; ssh takes no [address]:port (a port goes into ~/.ssh/config)")
    if host.lower().startswith("fe80:") and "%" not in host:
        parser.error(f"{host} is link-local: add the host's interface, e.g. {host}%eth0")
    args.func(args)


if __name__ == "__main__":
    main()
